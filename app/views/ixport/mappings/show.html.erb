<%= ui_form_page(title: "Match columns", back_url: root_path) %>
<%= ui_page(max_width: :md) do %>
  <%= ui_form(action: import_mapping_path(@import), method: :patch) do %>
    <%= ui_grid(cols: { default: 1 }, gap: :md) do %>
      <% @import.headers.each_with_index do |header, index| %>
        <%= tag.div(data: { column: true }) do %>
          <%= ui_grid(cols: { default: 1, sm: 2 }, gap: :sm) do %>
            <%= tag.span(header, data: { column_name: true }) %>
            <%= ui_select(name: "mapping[#{index}]", options: @fields.map { |field| [field.label, field.key] }, selected: @import.mapping&.dig(index.to_s), include_blank: "Skip") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= ui_button(label: "Save mapping") %>
  <% end %>
<% end %>
