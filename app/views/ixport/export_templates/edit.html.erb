<%= ui_form_page(title: "Edit #{@template.name}", subtitle: @template.registration.title, back_url: exports_path) %>
<%= ui_page(max_width: :md) do %>
  <%= ui_form(action: export_template_path(@template), method: :patch) do %>
    <%= ui_form_field(attribute: "name", label: "Template name", required: true, value: @template.name) %>
    <% column_options = @columns.map { |column| [column.label, column.key] } %>
    <% @columns.each_index do |index| %>
      <%= ui_form_field(attribute: "columns[]", label: "Column #{index + 1}", type: :select, options: column_options, include_blank: "None", value: @template.columns[index]) %>
    <% end %>
    <%= ui_button(label: "Save template") %>
  <% end %>
  <%= ui_action_menu do %>
    <%= ui_action_menu_item(label: "Delete", href: export_template_path(@template), method: :delete) %>
  <% end %>
<% end %>
