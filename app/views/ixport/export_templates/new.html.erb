<%= ui_form_page(title: "New #{@registration.title} template", back_url: exports_path) %>
<%= ui_page(max_width: :md) do %>
  <%= ui_form(action: export_templates_path(@registration.key)) do %>
    <%= ui_form_field(attribute: "name", label: "Template name", required: true, errors: @name_error.present? ? [tag.span(@name_error, data: { name_error: true })] : []) %>
    <% column_options = @columns.map { |column| [column.label, column.key] } %>
    <% @columns.each_index do |index| %>
      <%= ui_form_field(attribute: "columns[]", label: "Column #{index + 1}", type: :select, options: column_options, include_blank: "None") %>
    <% end %>
    <%= ui_button(label: "Save template") %>
  <% end %>
<% end %>
