<%= ui_show_page(title: "Preview", back_url: root_path) %>
<%= ui_page(max_width: :md) do %>
  <%= ui_page_header(title: "Preview") %>
  <%= ui_grid(cols: { default: 1, sm: 3 }) do %>
    <%= ui_stat_card(label: "Will add", value: tag.span(@counts[:add], data: { count: "add" })) %>
    <%= ui_stat_card(label: "Will update", value: tag.span(@counts[:update], data: { count: "update" })) %>
    <%= ui_stat_card(label: "Will be refused", value: tag.span(@counts[:refused], data: { count: "refused" })) %>
  <% end %>
<% end %>
