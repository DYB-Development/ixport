<%= ui_page(max_width: :md) do %>
  <h1>Imports</h1>
  <% if @registrations.empty? %>
    <%= ui_alert(message: "No imports are set up yet.") %>
  <% else %>
    <% @registrations.each do |registration| %>
      <div data-import><%= link_to registration.title, new_import_path(key: registration.key) %></div>
    <% end %>
  <% end %>
  <% if @imports.any? %>
    <%= ui_section(title: "Your imports") do %>
      <% @imports.each do |import| %>
        <div data-past-import>
          <%= link_to import_step_path(import), data: { step_link: true } do %><span data-import-title><%= import.title %></span><% end %>
          <span data-file-name><%= import.file.filename.to_s %></span>
          <span data-status><%= import.status.capitalize %></span>
          <span data-made-on><%= import.created_at.strftime("%b %-d, %Y") %></span>
          <% if import.finished? %>
            <span>Added <span data-added><%= import.added_count %></span></span>
            <span>Updated <span data-updated><%= import.updated_count %></span></span>
            <span>Refused <span data-refused><%= import.refusals.size %></span></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
